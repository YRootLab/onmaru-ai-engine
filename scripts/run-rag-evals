#!/usr/bin/env python3
"""Run a deterministic W17 replay and write the closed report JSON."""

from __future__ import annotations

import argparse
import json
from pathlib import Path

from onmaru_ai.evals.rag import evaluate_rag_replay


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("input", type=Path)
    parser.add_argument("--output", required=True, type=Path)
    arguments = parser.parse_args()
    value = json.loads(arguments.input.read_text(encoding="utf-8"))
    report = evaluate_rag_replay(value)
    arguments.output.write_text(
        report.model_dump_json(by_alias=True, indent=2) + "\n",
        encoding="utf-8",
    )
    return 0 if report.overall_passed else 1


if __name__ == "__main__":
    raise SystemExit(main())
