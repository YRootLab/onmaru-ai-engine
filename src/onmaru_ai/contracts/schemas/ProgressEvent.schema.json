{
  "$defs": {
    "StepKey": {
      "description": "Client timeline step keys for progress callback.",
      "enum": [
        "UNDERSTAND",
        "SEARCH",
        "SELECT",
        "WRITE",
        "CHECK"
      ],
      "title": "StepKey",
      "type": "string"
    },
    "StepStatus": {
      "description": "Step execution status for client timeline.",
      "enum": [
        "STARTED",
        "DONE",
        "SKIPPED"
      ],
      "title": "StepStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        "internal.ai.progress.v1",
        "ai-progress.v1"
      ],
      "title": "Schemaversion",
      "type": "string"
    },
    "runId": {
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
      "title": "Runid",
      "type": "string"
    },
    "planHash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Planhash",
      "type": "string"
    },
    "ordinal": {
      "minimum": 1,
      "title": "Ordinal",
      "type": "integer"
    },
    "stage": {
      "enum": [
        "PREPARING_INPUT",
        "RETRIEVING",
        "SELECTING_EVIDENCE",
        "GENERATING",
        "CHECKING_OUTPUT"
      ],
      "title": "Stage",
      "type": "string"
    },
    "stepKey": {
      "anyOf": [
        {
          "$ref": "#/$defs/StepKey"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/StepStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Count"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "planHash",
    "ordinal",
    "stage"
  ],
  "title": "ProgressEvent",
  "type": "object"
}
